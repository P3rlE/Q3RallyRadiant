<?xml version="1.0" encoding="UTF-8"?>
<classes>
  <list name="physics_mode">
    <item name="Use script/default" value=""/>
    <item name="Static" value="static"/>
    <item name="Dynamic" value="dynamic"/>
  </list>

  <point name="rally_scripted_object" color="0 0.9 0.1" box="-16 -16 -16 16 16 16">
    <model key="model" name="Model" value="">Model to display in Radiant and in-game. Choosing this field opens the model browser. Required for model-only props; overrides the model from an optional script.</model>
    <string key="script" name="Script">Optional scripted-object file, with or without the .script extension. Leave empty for a prop defined entirely by map keys.</string>
    <physics_mode key="physics" name="Physics">Static objects do not move. Dynamic objects use physics. Use script/default to preserve the script's moveable setting; model-only props default to static.</physics_mode>
    <integer key="mass" name="Mass">Dynamic-object mass. Default 100; valid range 1-100000.</integer>
    <real key="elasticity" name="Elasticity">Bounce response. Default 0.1; valid range 0-1.</real>
    <real key="friction" name="Friction">Surface friction. Default 0.6; valid range 0-4.</real>
    <integer key="health" name="Health">Hit points. Default 0 (indestructible); values above 0 make the prop damageable.</integer>
    <real3 key="mins" name="Collision mins">Minimum collision-box corner relative to the entity origin. Set together with maxs.</real3>
    <real3 key="maxs" name="Collision maxs">Maximum collision-box corner relative to the entity origin. Without script bounds, defaults are mins -16 -16 -16 and maxs 16 16 16.</real3>
    <angle key="angle" name="Angle" value="0">Yaw orientation of the model.</angle>
  </point>
</classes>
